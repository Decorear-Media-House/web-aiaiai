# docker-compose.prod.yml configuration
# Copy this file to .env.prod and edit BEFORE running `docker compose up`.
#
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# --- WordPress site ----------------------------------------------------------
# WP_DOMAIN is the PUBLIC URL of the CMS — used for WP_HOME/SITEURL and baked
# into the Next.js client bundle for image/form requests. Set DNS + reverse
# proxy (or direct port) so this resolves to the EC2 host.
WP_DOMAIN=cms.example.com
WP_PROTOCOL=https
WP_HTTP_PORT=8080
WP_SITE_TITLE=AIAIAI CMS

# --- Frontend ----------------------------------------------------------------
FRONTEND_HTTP_PORT=3000

# --- WordPress admin (created on first boot) ---------------------------------
# WP_ADMIN_PASS must be changed — init container refuses to run with the
# placeholder value or any password shorter than 8 characters.
WP_ADMIN_USER=admin
WP_ADMIN_PASS=CHANGE_ME_BEFORE_FIRST_UP
WP_ADMIN_EMAIL=admin@example.com

# --- MySQL -------------------------------------------------------------------
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=CHANGE_ME_DB_USER
MYSQL_ROOT_PASSWORD=CHANGE_ME_DB_ROOT

# --- Revalidation secret -----------------------------------------------------
# Shared between WordPress (AIAIAI_REVALIDATE_SECRET) and the Next.js
# /api/revalidate endpoint. The Deploy button in WP Admin sends this in the
# x-revalidate-secret header so the frontend cache only accepts trusted calls.
REVALIDATE_SECRET=CHANGE_ME_REVALIDATE_SECRET

# --- Crocoblock / JetEngine license -----------------------------------------
# Get from crocoblock.com → My Account → My Licenses. Init container will
# activate automatically on first boot if the plugin zip is in
# wordpress/premium-plugins/. Leave blank if you don't have a license — the
# plugin still installs, you'll just see "unlicensed" in Crocoblock menu.
JET_ENGINE_LICENSE=
