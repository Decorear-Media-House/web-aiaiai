# Per-environment deploy targets for deploy.sh.
# Copy to .env.deploy and edit. .env.deploy is gitignored.
#
#   cp .env.deploy.example .env.deploy
#   bash deploy.sh

# SSH host alias (from ~/.ssh/config) for the WordPress (CMS) server.
CMS_HOST=cms-host
# Absolute or ~ path to the WordPress install on CMS_HOST.
CMS_ROOT=~/htdocs/cms.example.com

# SSH host alias for the static frontend host. Can be the same as CMS_HOST
# if the static export and CMS share a server.
DEPLOY_HOST=frontend-host
# Web root that serves the Next.js static export on DEPLOY_HOST.
DEPLOY_ROOT=~/htdocs/example.com

# Public URL of the CMS — used for Next.js build-time API calls and to
# rewrite localhost URLs in seeded WP content during --full deploys.
PROD_WP_URL=https://cms.example.com

# Optional overrides. Defaults are derived from PROD_WP_URL.
# PROD_API_URL=https://cms.example.com/wp-json
# PROD_SITE_URL=https://example.com
